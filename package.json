{
  "name": "habitstreak",
  "version": "1.0.0",
  "description": "A habit tracker SaaS — create habits, log daily check-ins, and track streaks.",
  "main": "server/server.ts",
  "scripts": {
    "dev:server": "nodemon --exec ts-node server/server.ts",
    "dev:client": "vite",
    "dev": "npm run dev:server & npm run dev:client",
    "build": "tsc --project tsconfig.json && vite build",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.client.json",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "start": "node dist/server/server.js"
  },
  "keywords": [
    "habit",
    "tracker",
    "streak",
    "saas"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "google-auth-library": "^11.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^8.5.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^8.2.0"
  }
}
